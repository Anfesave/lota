# Copiar a apps/server/.env para desarrollo local.
# En produccion estas variables se definen en el panel de Render, NUNCA en el repo.

NODE_ENV=development

# Render inyecta PORT automaticamente; en local mandamos nosotros.
PORT=3000
# Debe ser 0.0.0.0 para que Render pueda alcanzar el proceso.
HOST=0.0.0.0

# --- Base de datos ---
# Local: la instancia de docker-compose (pnpm db:up).
# Produccion: cadena de Neon CON pooler, el host contiene "-pooler".
#   postgres://USER:PASS@ep-xxx-pooler.us-east-1.aws.neon.tech/lota?sslmode=require
DATABASE_URL=postgres://lota:lota@localhost:5432/lota

# Solo produccion: cadena de Neon SIN pooler, usada unicamente por las migraciones
# (PgBouncer en modo transaccion no soporta todo el DDL).
#   postgres://USER:PASS@ep-xxx.us-east-1.aws.neon.tech/lota?sslmode=require
# En local dejar vacio: se usa DATABASE_URL.
# DATABASE_URL_DIRECT=

# --- Sesiones ---
# Minimo 32 caracteres. En Render lo genera el blueprint (generateValue: true).
# Generar en local con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiame-por-un-secreto-largo-y-aleatorio-de-al-menos-32-chars

# Origen publico del sitio; se usa para armar los links de invitacion.
# En produccion: https://lota.onrender.com
PUBLIC_URL=http://localhost:5173

# Solo desarrollo: en produccion la SPA y la API comparten origen y no hay CORS.
CORS_ORIGIN=http://localhost:5173
